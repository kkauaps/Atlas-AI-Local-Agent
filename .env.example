# Copie para .env (gitignored) e preencha só o que for usar. Nada aqui é enviado sem a sua aprovação.

# API de fallback (OpenAI-compatível)
ATLAS_API_BASE=
ATLAS_API_KEY=
ATLAS_API_MODEL=
ATLAS_API_MODEL_CODER=
ATLAS_API_DAILY_USD=0.50
ATLAS_API_PRICE_IN=0.30
ATLAS_API_PRICE_OUT=1.20

# X (API oficial, OAuth 1.0a do app com permissão Read and Write). Sem isso: só rascunho em drafts/x
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# E-mail (SMTP). Gmail: smtp.gmail.com, 587, starttls, senha de app. Sem isso: só rascunho em drafts/email
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Código / git
ATLAS_DEV_ROOT=
ATLAS_ALLOW_PUSH_MAIN=0

# Outros
ATLAS_SEARXNG_URL=
ATLAS_VISION_MODEL=qwen2.5vl:3b
ATLAS_DISCOS=C:,D:
ATLAS_TOAST=1
PLAYWRIGHT_BROWSERS_PATH=D:\playwright
ATLAS_CODE_AGENT=
